@@ -0,0 +1,204 @@
+"""
+tests/test_rebuild_vector_index.py
+--------------------------------------
+Regression test for a real production bug: `rebuild_vector_index()`
+pointed at an already-populated vector store path appended freshly
+re-embedded active-chunk vectors ON TOP of the stale ones already there,
+because both NumpyVectorStore/FaissVectorStore load existing data on
+construction (correct behavior for normal startup) and the old
+implementation called the factory directly on the LIVE path. Confirmed
+in production: 360 stale + 197 active = 557, not 197.
+
+This test reproduces the same shape of bug with small numbers (fast,
+deterministic) and confirms the fix produces exactly the active count,
+never the sum.
+
+Run with: python3 tests/test_rebuild_vector_index.py
+"""
+
+import os
+import sys
+import shutil
+import tempfile
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
+
+from db import SqliteBackend
+from embeddings import HashingTfidfEmbeddings
+from vector_store import NumpyVectorStore, get_vector_store
+from ingestion_pipeline import (
+    IngestionInput, ingest_document, remove_document,
+    rebuild_vector_index, RebuildVerificationError,
+)
+
+
+def _fresh_env():
+    tmpdir = tempfile.mkdtemp(prefix="cmt_veda_rebuild_test_")
+    db = SqliteBackend(os.path.join(tmpdir, "test.db"))
+    embedder = HashingTfidfEmbeddings(n_features=256)
+    store_path = os.path.join(tmpdir, "vs", "store")
+    vs = NumpyVectorStore(store_path, dim=256)
+    return tmpdir, store_path, db, embedder, vs
+
+
+def test_rebuild_does_not_append_onto_stale_store():
+    """The exact reported bug, reproduced: a stale store with vectors
+    from since-removed documents, rebuilt in place, must end up with
+    EXACTLY the active-chunk count — not the stale count plus the active
+    count."""
+    tmpdir, store_path, db, embedder, vs = _fresh_env()
+    try:
+        docs = []
+        for i in range(5):
+            doc = ingest_document(db, embedder, vs, IngestionInput(
+                raw_text=f"Abstract\nDocument number {i} discussing CMT topic {i}. " * 6,
+                title=f"Doc {i}",
+            ), actor="test")
+            docs.append(doc)
+
+        stale_physical_count = vs.size()
+        assert stale_physical_count == 5
+
+        # Remove 2 of the 5 -- simulating documents superseded/removed
+        # since the store was last rebuilt.
+        remove_document(db, docs[0].document_id, actor="test")
+        remove_document(db, docs[1].document_id, actor="test")
+
+        active_count = len(db.get_active_chunk_ids())
+        assert active_count == 3
+        # The physical store is untouched by removal alone (expected --
+        # removal correctness comes from the DB-authoritative active
+        # filter at query time, not from mutating the vector store).
+        assert vs.size() == 5
+
+        # This is the exact call the production container ran.
+        rebuilt = rebuild_vector_index(
+            db, embedder, lambda p, d: get_vector_store("numpy", p, d), store_path,
+        )
+
+        print(f"stale_physical_count={stale_physical_count}, active_count={active_count}, "
+              f"rebuilt.size()={rebuilt.size()}")
+        assert rebuilt.size() == active_count, (
+            f"BUG STILL PRESENT: expected exactly {active_count} (the active count), "
+            f"got {rebuilt.size()} (stale {stale_physical_count} + active {active_count} "
+            f"= {stale_physical_count + active_count} would indicate the append bug)"
+        )
+
+        # Confirm this holds against a COMPLETELY FRESH handle re-reading
+        # the files from disk too, not just the in-memory object the
+        # function happened to return.
+        reopened = NumpyVectorStore(store_path, dim=256)
+        assert reopened.size() == active_count
+        print(f"Rebuild produced exactly {active_count} vectors (not "
+              f"{stale_physical_count + active_count}) — confirmed both via the "
+              f"returned handle and a fresh re-read from disk: PASS")
+
+        # No leftover temp directories.
+        leftover = [p for p in os.listdir(os.path.dirname(store_path)) if p.startswith(".rebuild-")]
+        assert not leftover, f"temp rebuild directory not cleaned up: {leftover}"
+        print("No leftover temp rebuild directories: PASS")
+    finally:
+        db.close()
+        shutil.rmtree(tmpdir, ignore_errors=True)
+
+
+def test_rebuild_with_no_prior_store_still_correct():
+    """Sanity check: rebuilding when there was never a store at that path
+    at all (first-ever rebuild) still produces exactly the active count."""
+    tmpdir, store_path, db, embedder, vs = _fresh_env()
+    try:
+        for i in range(4):
+            ingest_document(db, embedder, vs, IngestionInput(
+                raw_text=f"Abstract\nDocument {i} about CMT. " * 6, title=f"D{i}",
+            ), actor="test")
+
+        fresh_store_path = os.path.join(tmpdir, "never_existed_before", "store")
+        rebuilt = rebuild_vector_index(
+            db, embedder, lambda p, d: get_vector_store("numpy", p, d), fresh_store_path,
+        )
+        assert rebuilt.size() == 4
+        print("Rebuild with no prior store at the path: correct count: PASS")
+    finally:
+        db.close()
+        shutil.rmtree(tmpdir, ignore_errors=True)
+
+
+def test_rebuild_verification_failure_leaves_live_store_untouched():
+    """If the rebuilt count somehow doesn't match the active count, the
+    live store must be left completely alone and the temp files cleaned
+    up -- this is a hard correctness gate, not best-effort."""
+    tmpdir, store_path, db, embedder, vs = _fresh_env()
+    try:
+        ingest_document(db, embedder, vs, IngestionInput(
+            raw_text="Abstract\nSome CMT content here. " * 6, title="D0",
+        ), actor="test")
+        original_live_size = vs.size()
+
+        class LyingVectorStore(NumpyVectorStore):
+            """Test double: claims a different size than it actually has,
+            to exercise the verification-failure path deterministically."""
+            def size(self):
+                return super().size() + 999  # deliberately wrong
+
+        def lying_factory(p, d):
+            return LyingVectorStore(p, d)
+
+        try:
+            rebuild_vector_index(db, embedder, lying_factory, store_path)
+            raise AssertionError("expected RebuildVerificationError")
+        except RebuildVerificationError as e:
+            print(f"Correctly raised RebuildVerificationError: {e}")
+
+        # Live store completely untouched.
+        reopened = NumpyVectorStore(store_path, dim=256)
+        assert reopened.size() == original_live_size
+        print(f"Live store unchanged after a failed verification "
+              f"(still {original_live_size}): PASS")
+
+        # No leftover temp directory from the failed attempt.
+        leftover = [p for p in os.listdir(os.path.dirname(store_path)) if p.startswith(".rebuild-")]
+        assert not leftover, f"temp directory not cleaned up after failure: {leftover}"
+        print("Temp files cleaned up after a failed verification: PASS")
+    finally:
+        db.close()
+        shutil.rmtree(tmpdir, ignore_errors=True)
+
+
+def test_faiss_style_suffix_collision_is_actually_avoided():
+    """Direct, isolated check of the path-construction bug described in
+    rebuild_vector_index()'s docstring: a naive `f"{path}.rebuild-{uuid}"`
+    temp name collapses back to the SAME filename as the live path once
+    Path.with_suffix('.faiss') is applied (it only looks at text after
+    the last dot). The fix must put the unique token in a directory
+    component instead."""
+    from pathlib import Path
+    import uuid
+
+    path = "runtime/faiss_index"
+
+    naive_temp = f"{path}.rebuild-{uuid.uuid4().hex}"
+    naive_collides = Path(naive_temp).with_suffix(".faiss") == Path(path).with_suffix(".faiss")
+    assert naive_collides, "this test's premise (the naive approach collides) no longer holds — re-check pathlib behavior"
+
+    temp_dir = Path(path).parent / f".rebuild-{uuid.uuid4().hex}"
+    fixed_temp = str(temp_dir / Path(path).name)
+    fixed_distinct = Path(fixed_temp).with_suffix(".faiss") != Path(path).with_suffix(".faiss")
+    assert fixed_distinct
+
+    print("Confirmed: naive suffix-based temp naming collides with the live "
+          "filename; the directory-based approach used in the fix does not: PASS")
+
+
+if __name__ == "__main__":
+    tests = [v for k, v in list(globals().items()) if k.startswith("test_")]
+    failures = 0
+    for t in tests:
+        print(f"\n--- {t.__name__} ---")
+        try:
+            t()
+        except Exception as e:
+            failures += 1
+            print(f"FAIL: {t.__name__}: {e}")
+    print(f"\n{len(tests) - failures}/{len(tests)} passed")
+    if failures:
+        sys.exit(1)
