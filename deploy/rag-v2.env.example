# RAG v2 production environment -- NAMES ONLY, no real values.
# Copy to /opt/cmtveda/rag-v2/rag-v2.env (OUTSIDE the repository), chmod 600,
# then replace every <...> with the real value. Never commit the real file.
# Compose reads it via env_file; docker-compose.yml fixes the non-secret
# topology (backends, redis URL, paths) so they are not repeated here.

# ---- Required secrets / endpoints ----
RAG_API_KEY=<user-api-key>
RAG_ADMIN_API_KEY=<admin-api-key>
# libpq URI or key=value string. The DB runs on the VPS host, so from inside
# the container the host is host.docker.internal (not localhost/127.0.0.1).
RAG_POSTGRES_DSN=<postgresql://USER:PASSWORD@host.docker.internal:5432/DBNAME>
# File name of the GGUF model inside the read-only models mount.
RAG_GGUF_MODEL_PATH=/opt/cmtveda/rag/runtime/models/<model-file>.gguf

# ---- Optional (defaults shown in config.py) ----
# RAG_KNOWLEDGE_VERSION=
# RAG_N_CTX=
# RAG_N_THREADS=
# RAG_MAX_QUESTION_CHARS=
# RAG_RQ_JOB_TIMEOUT_SECONDS=
# RAG_MAX_RETRIES=
# RAG_RETRY_BACKOFF_BASE_SECONDS=
# RAG_MIN_FULL_TEXT_CHARS=
